# 复制这个文件并改名为 .env，再把值填进去。.env 不会被提交到 git。

# ---- 必填 ----
KOOK_TOKEN=

# ---- 可选功能，不填就关掉对应功能 ----
# AI 聊天（Google Gemini）
GEMINI_API_KEY=
# 用哪个 Gemini 模型，不填用默认值
GEMINI_MODEL=gemini-3.6-flash
# 天气 /sky 和每日天气播报（OpenWeatherMap）
OWM_API_KEY=
# /dog 用的 api.oick.cn 密钥
DOG_API_KEY=
# 每日天气播报的频道 ID（KOOK 的频道 ID，约 16 位）
GENERAL_ID=
# 每日折扣播报的频道 ID
LOOT_ID=

# ---- 每日天气播报的城市 ----
# 格式：城市名,国家代码;城市名,国家代码
WEATHER_CITIES=Shanghai,CN;New York,US;Tokyo,JP

# ---- 用量上限，填 0 关闭该项 ----
# 每个服务器最多排多少首歌
MAX_QUEUE=50
# 每人最多挂多少条待触发的提醒
MAX_REMINDERS_PER_USER=20
# 发给 AI 的单张图片上限（MB）
MAX_IMAGE_MB=8
# 一条消息最多带几张图给 AI
MAX_IMAGES_PER_MESSAGE=4
# 同一个人两次 AI 回复的最短间隔（秒）
AI_COOLDOWN_SECONDS=3
# 每天最多调多少次 AI，0 = 不限
AI_DAILY_LIMIT=0

# ---- 语音，一般不用改 ----
# 音量倍率，1.0 = 原样
VOICE_VOLUME=1.0
# 码率（kbps），0 = 跟随频道设置
VOICE_BITRATE=0
# 码率低于这个值时转单声道，0 = 永远立体声
VOICE_MONO_BELOW=0
# 本地取流中转的端口
RELAY_PORT=17650
