# 复制这个文件并改名为 .env，再把值填进去。.env 不会被提交到 git。
# Copy this file to .env and fill in the values. .env is never committed to git.

# ---- 必填 / required ----
DISCORD_TOKEN=

# ---- 可选功能，不填就关掉对应功能 / optional features, leave empty to disable ----
# AI 聊天（Google Gemini） / AI chat
GEMINI_API_KEY=
# 天气 /sky 和每日天气播报（OpenWeatherMap） / weather
OWM_API_KEY=
# /dog 用的 api.oick.cn 密钥 / key for the /dog command
DOG_API_KEY=
# 每日天气播报的频道 ID / channel ID for the daily weather post
GENERAL_ID=
# 每日折扣播报的频道 ID / channel ID for the daily deals post
LOOT_ID=
# 填了就只同步到这个服务器，指令立刻生效；不填是全局同步，最多等 1 小时
# Set to sync commands to one server instantly; empty = global sync (up to 1 hour)
GUILD_ID=

# ---- 每日天气播报的城市 / cities for the daily weather post ----
# 格式：城市名,国家代码;城市名,国家代码  / format: City,CC;City,CC
WEATHER_CITIES=Shanghai,CN;New York,US;Tokyo,JP

# ---- 语言 / language: zh（默认，简体中文） 或 / or  en ----
LANGUAGE=zh

# ---- 用量上限，填 0 关闭该项 / limits, 0 turns one off ----
# 每个服务器最多排多少首歌 / songs queued per server
MAX_QUEUE=50
# 发给 AI 的单张图片上限（MB） / max size of an image sent to the AI
MAX_IMAGE_MB=8
# 一条消息最多带几张图给 AI / images per message sent to the AI
MAX_IMAGES_PER_MESSAGE=4
# 同一个人两次 AI 回复的最短间隔（秒） / seconds between AI replies to the same person
AI_COOLDOWN_SECONDS=3
# 每天最多调多少次 AI，0 = 不限 / AI calls per day, 0 = unlimited
AI_DAILY_LIMIT=0
